---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  album?: boolean | undefined;
}

const { title, description, image, album } = Astro.props;
const canonical = new URL(Astro.url.pathname + Astro.url.search, Astro.site ?? Astro.url.origin);

// og:image no admite rutas relativas: el crawler no resuelve contra la página,
// pide el path tal cual y no encuentra nada. Las portadas de iTunes ya vienen
// absolutas y `new URL` las deja intactas.
const ogImage = image ? new URL(image, Astro.site ?? Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {/* Antes del primer pintado: si esperáramos a React, el tema entraría con un
        flash del contrario. Sin elección guardada manda el sistema operativo. */}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('vinyl:theme');
        } catch {}
        const dark = saved
          ? saved === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Los crawlers no ejecutan JS: estas etiquetas se arman en el servidor. */}
    {/* music.album sólo cuando lo compartido es un disco. En la home no hay
        álbum, y el tipo equivocado hace que algunos lectores busquen metadatos
        de música que no existen. */}
    <meta property="og:type" content={album ? 'music.album' : 'website'} />
    <meta property="og:site_name" content="deadwax" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Ruta absoluta desde la raíz servida: lo que está en public/ se publica en
        la raíz del sitio. Una ruta relativa al archivo fuente no existe en el
        build y el navegador la pide contra el dominio, donde no hay nada. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..600&family=Geist+Mono:wght@300..500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
