---
import Analytics from '@vercel/analytics/astro';
import { OG_IMAGE } from '../lib/meta';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  album?: boolean | undefined;
}

const { title, description, album } = Astro.props;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname + Astro.url.search, site);

// La imagen no es un prop: cualquier página que pudiera elegir la suya termina
// eligiéndola distinta. og:image tampoco admite rutas relativas, el crawler pide
// el path tal cual contra su propio dominio y no encuentra nada.
const ogImage = new URL(OG_IMAGE, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {/* Antes del primer pintado: si esperáramos a React, el tema entraría con un
        flash del contrario. Sin elección guardada manda el sistema operativo. */}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('vinyl:theme');
        } catch {}
        const dark = saved
          ? saved === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Los crawlers no ejecutan JS: estas etiquetas se arman en el servidor. */}
    {/* music.album sólo cuando lo compartido es un disco. En la home no hay
        álbum, y el tipo equivocado hace que algunos lectores busquen metadatos
        de música que no existen. */}
    <meta property="og:type" content={album ? 'music.album' : 'website'} />
    <meta property="og:site_name" content="deadwax" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />

    {/* Ruta absoluta desde la raíz servida: lo que está en public/ se publica en
        la raíz del sitio. Una ruta relativa al archivo fuente no existe en el
        build y el navegador la pide contra el dominio, donde no hay nada. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..600&family=Geist+Mono:wght@300..500&display=swap"
    />
  </head>
  <body>
    <slot />
    {/* Se inyecta siempre, pero sólo registra donde el proyecto tiene Web
        Analytics activo: en local apunta al script de debug y no reporta nada.
        Al final del body para que no compita con el primer pintado. */}
    <Analytics />
  </body>
</html>
