---
import Base from '../layouts/Base.astro';
import VinylApp from '../components/VinylApp';
import { SEED } from '../data/records';
import { getAlbum } from '../lib/itunes';
import { decodeShelf } from '../lib/shelf';
import { SITE_TITLE } from '../lib/meta';

// On-demand en vez de prerenderizada: un enlace compartido tiene que llegar
// con su título y su portada ya en el HTML, porque los crawlers no corren JS.
export const prerender = false;

const params = Astro.url.searchParams;

const requested = params.get('record') ?? '';
const shared = /^\d+$/.test(requested) ? await getAlbum(requested).catch(() => null) : null;

// Sólo para el título: la tapa ya no se pide, la imagen del enlace es siempre
// la del sitio y traerla costaba una vuelta a iTunes antes de responder.
const shelf = decodeShelf(params);

let title = SITE_TITLE;
let description = 'An experiment in listening to records on the web. Pull a sleeve, drop the needle.';

if (shared) {
  title = `deadwax · ${shared.title} by ${shared.artist}`;
  description = `${shared.title} by ${shared.artist}${shared.year ? `, ${shared.year}` : ''}. Spinning at 33⅓ RPM on deadwax.`;
} else if (shelf) {
  title = `deadwax · ${shelf.name || 'A shelf'}`;
  description = `${shelf.name || 'A shelf'}: ${shelf.ids.length} records someone put on a shelf. Open it and drop the needle.`;
}
---

<Base title={title} description={description} album={!!shared}>
  <main>
    <VinylApp client:load seed={SEED} />
  </main>
</Base>
